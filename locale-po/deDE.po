msgctxt "Sell Junk"
msgid "Sell Junk"
msgstr "Ramsch verk"

msgctxt "Sold"
msgid "Sold"
msgstr "Verkauft"

msgctxt "Only 1 item stack can be destroyed at the time"
msgid "Only 1 item stack can be destroyed at the time"
msgstr "Nur ein Item-Stapel kann gleichzeitig zerstört werden"

msgctxt "Destroyed"
msgid "Destroyed"
msgstr "Zerstört"

msgctxt "Gained"
msgid "Gained"
msgstr "Erlös"

msgctxt "Added"
msgid "Added"
msgstr "Hinzugefügt"

msgctxt "Removed"
msgid "Removed"
msgstr "Entfernt"

msgctxt "Exceptions succesfully cleared."
msgid "Exceptions successfully cleared."
msgstr "Ausnahmen erfolgreich entfernt."

msgctxt "Command accepts only itemlinks."
msgid "Command accepts only itemlinks."
msgstr "Befehl akzeptiert nur Gegenstandslinks."

msgctxt "Automatically sell junk"
msgid "Automatically sell junk"
msgstr "Ramsch automatisch verkaufen"

msgctxt "Toggles the automatic selling of junk when the merchant window is opened."
msgid "Toggles the automatic selling of junk when the merchant window is opened."
msgstr "Schaltet das automatische Verkaufen von Ramsch bei geöffnetem Händler-Fenster ein oder aus."

msgctxt "Sell max. 12 items"
msgid "Sell max. 12 items"
msgstr "Verkaufe max. 12 Gegenstände"

msgctxt "This is failsafe mode. Will sell only 12 items in one pass. In case of an error, all items can be bought back from vendor."
msgid "This is failsafe mode. Will sell only 12 items in one pass. In case of an error, all items can be bought back from vendor."
msgstr "Abgesicherter Modus. Es werden nur 12 Gegenstände auf einmal verkauft, sodass diese bei Fehlern noch beim Händler zurückgekauft werden können."

msgctxt "Show gold gained"
msgid "Show gold gained"
msgstr "Erlös anzeigen"

msgctxt "Shows gold gained from selling trash."
msgid "Shows gold gained from selling trash."
msgstr "Zeigt den Erlös vom Ramsch-Verkauf."

msgctxt "Show 'item sold' spam"
msgid "Show 'item sold' spam"
msgstr "Zeige \\"

msgctxt "Prints itemlinks to chat, when automatically selling items."
msgid "Prints itemlinks to chat, when automatically selling items."
msgstr "Gibt beim automatischen Verkauf von Gegenständen die dazugehörigen Links im Chat-Fenster aus."

msgctxt "Clear exceptions"
msgid "Clear exceptions"
msgstr "Ausnahmelisten löschen"

msgctxt "Clear"
msgid "Clear"
msgstr "Globale löschen"

msgctxt "Removes all exceptions."
msgid "Removes all exceptions."
msgstr "Entfernt alle globalen Ausnahmen."

msgctxt "Exceptions"
msgid "Exceptions"
msgstr "Globale Ausnahmen"

msgctxt "Drag item into this window to add/remove it from exception list"
msgid "Drag item into this window to add/remove it from exception list"
msgstr "Gegenstand in dieses Fenster ziehen, um ihn der Ausnahmenliste hinzuzufügen oder zu entfernen"

msgctxt "Add item"
msgid "Add item"
msgstr "Gegenstand hinzufügen"

msgctxt "<Item Link>"
msgid "<Item Link>"
msgstr "<Gegenstands-Link>"

msgctxt "Remove item"
msgid "Remove item"
msgstr "Gegenstand entfernen"
