msgid "Command accepts only itemlinks."
msgstr "Принимаются только прямые ссылки на предметы."

msgctxt "Automatically sell junk"
msgid "Automatically sell junk"
msgstr "Продавать \\"

msgctxt ""
"Toggles the automatic selling of junk when the merchant window is opened."
msgid ""
"Toggles the automatic selling of junk when the merchant window is opened."
msgstr "Включить или отключить автоматическую продажу мусора при открытии окна торговли."

msgctxt "Sell max. 12 items"
msgid "Sell max. 12 items"
msgstr "Продавать не более 12 предметов"

msgctxt ""
"This is failsafe mode. Will sell only 12 items in one pass. In case of an "
"error, all items can be bought back from vendor."
msgid ""
"This is failsafe mode. Will sell only 12 items in one pass. In case of an "
"error, all items can be bought back from vendor."
msgstr "Безопасный режим. Продает не более 12 предметов. В случае ошибки, любой из предметов может быть выкуплен у продавца обратно."

msgctxt "Show gold gained"
msgid "Show gold gained"
msgstr "Показывать выручку"

msgctxt "Shows gold gained from selling trash."
msgid "Shows gold gained from selling trash."
msgstr "Показывает выручку с продажи мусора."

msgctxt "Show 'item sold' spam"
msgid "Show 'item sold' spam"
msgstr "Показывать сообщения \\"

msgctxt "Prints itemlinks to chat, when automatically selling items."
msgid "Prints itemlinks to chat, when automatically selling items."
msgstr "Выводит прямые ссылки на предметы в чат во время автоматической продажи предметов."

msgctxt "Clear exceptions"
msgid "Clear exceptions"
msgstr "Очистить исключения"

