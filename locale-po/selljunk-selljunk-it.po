#, fuzzy
msgctxt "Exceptions succesfully cleared."
msgid "Exceptions successfully cleared."
msgstr "Eccezioni cancellate con successo."

msgctxt "Command accepts only itemlinks."
msgid "Command accepts only itemlinks."
msgstr "Il comando accetta solo link a oggetti."

msgctxt "Automatically sell junk"
msgid "Automatically sell junk"
msgstr "Vendi automaticamente oggetti grigi"

msgctxt ""
"Toggles the automatic selling of junk when the merchant window is opened."
msgid ""
"Toggles the automatic selling of junk when the merchant window is opened."
msgstr "Attiva la vendita dei grigi automatica quando viene aperta la finestra di un mercante."

msgctxt "Sell max. 12 items"
msgid "Sell max. 12 items"
msgstr "Vendi max. 12 oggetti"

msgctxt ""
"This is failsafe mode. Will sell only 12 items in one pass. In case of an "
"error, all items can be bought back from vendor."
msgid ""
"This is failsafe mode. Will sell only 12 items in one pass. In case of an "
"error, all items can be bought back from vendor."
msgstr "Questa è la modalità anti-errore. Verranno venduti solo 12 oggetti per volta. In caso di errore, potranno essere tutti ricomprati dal venditore."

msgctxt "Show gold gained"
msgid "Show gold gained"
msgstr "Mostra oro ottenuto"

msgctxt "Shows gold gained from selling trash."
msgid "Shows gold gained from selling trash."
msgstr "Mostra oro ottenuto vendendo oggetti inutili."

msgctxt "Show 'item sold' spam"
msgid "Show 'item sold' spam"
msgstr "Visualizza le scritte"

msgctxt "Prints itemlinks to chat, when automatically selling items."
msgid "Prints itemlinks to chat, when automatically selling items."
msgstr "Scrivi nella chat i link agli oggetti quando vendi automaticamente gli oggetti."

msgctxt "Clear exceptions"
msgid "Clear exceptions"
msgstr "Vuota eccezioni"

msgctxt "Clear"
msgid "Clear"
msgstr "Vuota"

msgctxt "Removes all exceptions."
msgid "Removes all exceptions."
msgstr "Rimuove tutte le eccezioni."

msgctxt "Exceptions"
msgid "Exceptions"
msgstr "Eccezioni"

msgctxt "Drag item into this window to add/remove it from exception list"
msgid "Drag item into this window to add/remove it from exception list"
msgstr "Trascina un oggetto in questa finestra per aggiungerlo/rimuoverlo dalla lista delle eccezioni"

msgctxt "Add item"
msgid "Add item"
msgstr "Aggiungi oggetto"

